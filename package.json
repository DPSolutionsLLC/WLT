{
  "name": "ward-leadership-tools",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --disable-warning=ExperimentalWarning --experimental-strip-types testing/infrastructure/seedRunner.ts",
    "seed:clean": "node --disable-warning=ExperimentalWarning --experimental-strip-types testing/infrastructure/cleanUp.ts",
    "manifest": "node --disable-warning=ExperimentalWarning --experimental-strip-types testing/infrastructure/manifestGenerator.ts",
    "knowledge:ingest": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./supabase/scripts/register.mjs supabase/scripts/ingestStandardWorks.ts",
    "knowledge:ingest-conference": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./supabase/scripts/register.mjs supabase/scripts/ingestConference.ts",
    "harness:typecheck": "tsc --noEmit -p testing/tsconfig.json",
    "db:link": "supabase link --project-ref dtlvpeqirajfbqaydcgr",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset --linked",
    "db:types": "supabase gen types typescript --linked > types/database.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@react-pdf/renderer": "^4.6.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.4.0",
    "next": "16.3.1",
    "openai": "^7.4.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^29.1.1",
    "supabase": "^2.114.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
