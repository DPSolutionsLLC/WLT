NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=

# The address programme emails are sent FROM. Must be at a domain VERIFIED in Resend.
#
# Leaving this empty switches email distribution off: the Distribute button becomes "Publish to
# the public page" and says so. That is deliberate — Resend's shared test sender
# (onboarding@resend.dev) only delivers to the Resend account owner, so a send with it configured
# reports success and reaches nobody else. Setting this to a verified address is the only thing
# needed to turn email on; there is no code change and no deploy flag.
RESEND_FROM_ADDRESS=

# The public origin, with no trailing slash — e.g. https://wlt-iota.vercel.app
#
# This is what the QR code printed on the back of every programme encodes. On Vercel,
# VERCEL_PROJECT_PRODUCTION_URL is used as a fallback; VERCEL_URL is deliberately NOT, because it
# changes on every deployment and a QR pointing at it would 404 on paper already handed out.
#
# With neither set, the programme prints WITHOUT a QR code and the generate route says so. It
# never guesses at localhost.
NEXT_PUBLIC_SITE_URL=
