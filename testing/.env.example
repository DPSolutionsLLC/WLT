# Harness environment overrides.
#
# Everything here is optional. The harness reads the root .env.local first, so you only need
# this file to point the harness somewhere different from the app.
#
# Required once, in .env.local OR here:
#   the password for every @harness.wardleadershiptools.test account. These accounts can sign
#   in to the real app, so it is not hardcoded in the repo. Minimum 12 characters.
HARNESS_TEST_PASSWORD=

# Only if the harness should target a different project from the app:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
